// Prisma Client generation, migrate, and deploy are separate steps.
// - Generate Client: `npm run prisma:generate` (TypeScript client only; no DB changes)
// - Development migrate: `npm run prisma:migrate` (create + apply a new versioned migration)
// - Deploy migrations: `npm run prisma:deploy` (apply existing migrations; use this in shared environments)
// Do not infer a migrated database from container start order. Do not use migrate reset unless authorized.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id         String   @id @db.Uuid
  recordedAt DateTime

  @@map("system_probes")
}

model User {
  id          String   @id @db.Uuid
  email       String   @unique // stored canonical lowercase
  displayName String
  createdAt   DateTime

  passwordCredential AuthPasswordCredential?
  sessions           AuthSession[]
  ownedProjects      Project[]
  projectMemberships ProjectMember[]
  authoredTaskComments TaskComment[]
  taskActivityEvents TaskActivityEvent[]

  @@map("users")
}

model AuthPasswordCredential {
  userId       String @id @db.Uuid
  passwordHash String
  user         User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("auth_credentials")
}

model AuthSession {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TaskActivityKind {
  TASK_CREATED
  TASK_FIELDS_CHANGED
  TASK_SOFT_DELETED
  COMMENT_ADDED
}

model Project {
  id          String    @id @db.Uuid
  ownerUserId String    @db.Uuid
  name        String
  description String?
  createdAt   DateTime
  archivedAt  DateTime?
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  tasks       Task[]
  members     ProjectMember[]

  @@index([ownerUserId])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String       @id @db.Uuid
  projectId   String       @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  createdAt   DateTime
  deletedAt   DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  comments    TaskComment[]
  activityEvents TaskActivityEvent[]

  @@index([projectId])
  @@map("tasks")
}

model TaskComment {
  id           String    @id @db.Uuid
  taskId       String    @db.Uuid
  authorUserId String    @db.Uuid
  body         String
  createdAt    DateTime
  deletedAt    DateTime?
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author       User      @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("task_comments")
}

model TaskActivityEvent {
  id          String           @id @db.Uuid
  taskId      String           @db.Uuid
  actorUserId String           @db.Uuid
  kind        TaskActivityKind
  payload     Json
  createdAt   DateTime
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@map("task_activity_events")
}
