// Prisma Client generation, migrate, and deploy are separate steps.
// - Generate Client: `npm run prisma:generate` (TypeScript client only; no DB changes)
// - Development migrate: `npm run prisma:migrate` (create + apply a new versioned migration)
// - Deploy migrations: `npm run prisma:deploy` (apply existing migrations; use this in shared environments)
// Do not infer a migrated database from container start order. Do not use migrate reset unless authorized.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id         String   @id @db.Uuid
  recordedAt DateTime

  @@map("system_probes")
}

model User {
  id          String   @id @db.Uuid
  email       String   @unique // stored canonical lowercase
  displayName String
  createdAt   DateTime

  passwordCredential AuthPasswordCredential?
  sessions           AuthSession[]
  ownedProjects      Project[]
  projectMemberships ProjectMember[]
  authoredTaskComments TaskComment[]
  taskActivityEvents TaskActivityEvent[]
  uploadedTaskAttachments TaskAttachment[]
  uploadedProjectCovers ProjectCover[]

  @@map("users")
}

model AuthPasswordCredential {
  userId       String @id @db.Uuid
  passwordHash String
  user         User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("auth_credentials")
}

model AuthSession {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TaskActivityKind {
  TASK_CREATED
  TASK_FIELDS_CHANGED
  TASK_SOFT_DELETED
  COMMENT_ADDED
  CHECKLIST_ADDED
  CHECKLIST_REMOVED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_UNCOMPLETED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  COVER_CHANGED
}

model Project {
  id          String    @id @db.Uuid
  ownerUserId String    @db.Uuid
  name        String
  description String?
  createdAt   DateTime
  archivedAt  DateTime?
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  tasks       Task[]
  members     ProjectMember[]
  labels      ProjectLabel[]
  statuses    ProjectStatus[]
  cover       ProjectCover?

  @@index([ownerUserId])
  @@map("projects")
}

model ProjectCover {
  id               String   @id @db.Uuid
  projectId        String   @unique @db.Uuid
  uploadedByUserId String   @db.Uuid
  originalFilename String
  contentType      String
  sizeBytes        Int
  storageKey       String   @unique
  createdAt        DateTime
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@map("project_covers")
}

model ProjectMember {
  id        String            @id @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String       @id @db.Uuid
  projectId   String       @db.Uuid
  title       String
  description String?
  status      String       @default("TODO")
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  createdAt   DateTime
  deletedAt   DateTime?
  /// Dense within-column rank for live tasks per (projectId, status). Soft-deleted rows are excluded from the live partial unique index.
  position    Int          @default(0)
  coverAttachmentId String? @unique @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  comments    TaskComment[]
  activityEvents TaskActivityEvent[]
  taskLabels  TaskLabel[]
  checklists  TaskChecklist[]
  attachments TaskAttachment[] @relation("TaskAttachments")
  coverAttachment TaskAttachment? @relation("TaskCover", fields: [coverAttachmentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, status, position])
  @@map("tasks")
}

model TaskAttachment {
  id               String   @id @db.Uuid
  taskId           String   @db.Uuid
  uploadedByUserId String   @db.Uuid
  originalFilename String
  contentType      String
  sizeBytes        Int
  storageKey       String   @unique
  createdAt        DateTime
  task             Task     @relation("TaskAttachments", fields: [taskId], references: [id], onDelete: Restrict)
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  coveredTask      Task?    @relation("TaskCover")

  @@index([taskId])
  @@index([taskId, createdAt])
  @@map("task_attachments")
}

model TaskChecklist {
  id        String              @id @db.Uuid
  taskId    String              @db.Uuid
  name      String
  createdAt DateTime
  task      Task                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  items     TaskChecklistItem[]

  @@index([taskId])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id          String        @id @db.Uuid
  checklistId String        @db.Uuid
  text        String
  checked     Boolean       @default(false)
  createdAt   DateTime
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("task_checklist_items")
}

model ProjectLabel {
  id        String   @id @db.Uuid
  projectId String   @db.Uuid
  name      String
  nameKey   String
  color     String
  createdAt DateTime
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  taskLabels TaskLabel[]

  @@unique([projectId, nameKey])
  @@index([projectId])
  @@map("project_labels")
}

model ProjectStatus {
  id          String   @id @db.Uuid
  projectId   String   @db.Uuid
  key         String
  name        String
  nameKey     String
  color       String
  isSystem    Boolean
  isCompleted Boolean
  position    Int
  createdAt   DateTime
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, key])
  @@unique([projectId, nameKey])
  @@unique([projectId, position])
  @@index([projectId])
  @@index([projectId, position])
  @@map("project_statuses")
}

model TaskLabel {
  taskId    String       @db.Uuid
  labelId   String       @db.Uuid
  createdAt DateTime
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  label     ProjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

model TaskComment {
  id           String    @id @db.Uuid
  taskId       String    @db.Uuid
  authorUserId String    @db.Uuid
  body         String
  createdAt    DateTime
  deletedAt    DateTime?
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author       User      @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("task_comments")
}

model TaskActivityEvent {
  id          String           @id @db.Uuid
  taskId      String           @db.Uuid
  actorUserId String           @db.Uuid
  kind        TaskActivityKind
  payload     Json
  createdAt   DateTime
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@map("task_activity_events")
}
