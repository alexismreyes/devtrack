// Prisma Client generation, migrate, and deploy are separate steps.
// - Generate Client: `npm run prisma:generate` (TypeScript client only; no DB changes)
// - Development migrate: `npm run prisma:migrate` (create + apply a new versioned migration)
// - Deploy migrations: `npm run prisma:deploy` (apply existing migrations; use this in shared environments)
// Do not infer a migrated database from container start order. Do not use migrate reset unless authorized.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id         String   @id @db.Uuid
  recordedAt DateTime

  @@map("system_probes")
}

model User {
  id          String   @id @db.Uuid
  email       String   @unique // stored canonical lowercase
  displayName String
  createdAt   DateTime

  passwordCredential AuthPasswordCredential?
  sessions           AuthSession[]
  ownedProjects      Project[]

  @@map("users")
}

model AuthPasswordCredential {
  userId       String @id @db.Uuid
  passwordHash String
  user         User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("auth_credentials")
}

model AuthSession {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model Project {
  id          String    @id @db.Uuid
  ownerUserId String    @db.Uuid
  name        String
  description String?
  createdAt   DateTime
  archivedAt  DateTime?
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  @@map("projects")
}
