# Copy to `.env` and replace placeholders. Do not commit real secrets.
# This file contains names and dummy values only.

# PostgreSQL (Compose service `db`)
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=replace-me
POSTGRES_PORT=5432

# Backend (host-run API and tests). Compose `backend` does not use this URL;
# it builds DATABASE_URL with hostname `db` from POSTGRES_*.
DATABASE_URL=postgresql://replace-me:replace-me@localhost:5432/replace-me
CORS_ORIGIN=http://localhost:5173
PORT=3000
# Local attachment blob root (Q-131). Compose mounts named volume at /data/attachments.
ATTACHMENTS_ROOT=./data/attachments
# Local project cover blob root (Q-159). Compose mounts named volume at /data/project-covers.
PROJECT_COVERS_ROOT=./data/project-covers

# Frontend (browser-reachable published backend origin).
# Compose `frontend` receives only this variable — never DATABASE_URL or `db`.
VITE_API_URL=http://localhost:3000
